Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Value: true
      Cell Size: 1
      Line Style:
        Line Width: 0.03
        Value: Lines
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 15
      Reference Frame: <Fixed Frame>
      Color: 80; 80; 80

    # ── OctoMap 3D Obstacles (Semantic Colors) ─────────────────────────────
    - Class: rviz_default_plugins/MarkerArray
      Name: "OctoMap — Semantic 3D Map"
      Enabled: true
      Topic:
        Value: /occupied_cells_vis_array
        Depth: 5
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Queue Size: 5

    # ── A* Planned Path (CYAN LINE) ─────────────────────────────────────────
    - Class: rviz_default_plugins/Path
      Name: "A* Planned Path"
      Enabled: true
      Topic:
        Value: /plan
        Depth: 5
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Color: 0; 220; 255
      Line Width: 0.06
      Head Diameter: 0.2
      Head Length: 0.1
      Shaft Diameter: 0.06
      Buffer Length: 1

    # ── Benchmark: All 6 Algorithm Paths (COLORED) ──────────────────────────
    - Class: rviz_default_plugins/MarkerArray
      Name: "Benchmark — All Paths"
      Enabled: true
      Topic:
        Value: /benchmark_paths
        Depth: 5
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Queue Size: 5

    # ── Raw Point Cloud (OFF by default — turn on for debugging only) ───────
    - Class: rviz_default_plugins/PointCloud2
      Name: Raw Point Cloud (debug)
      Enabled: false
      Topic:
        Value: /depth_camera/points
        Depth: 1
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Size (Pixels): 1
      Style: Points
      Color Transformer: FlatColor
      Color: 160; 160; 160
      Decay Time: 0
      Use Fixed Frame: true

    # ── Filtered Point Cloud (OFF — we use OctoMap for visualization) ────────
    - Class: rviz_default_plugins/PointCloud2
      Name: Filtered Point Cloud (debug)
      Enabled: false
      Topic:
        Value: /depth_camera/points_filtered
        Depth: 1
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Size (Pixels): 2
      Style: Points
      Color Transformer: FlatColor
      Color: 200; 200; 200
      Decay Time: 0
      Use Fixed Frame: true

    # ── Semantic Colored Point Cloud (YOLOv8 labels) ────────────────────────
    - Class: rviz_default_plugins/PointCloud2
      Name: "Semantic 3D Map (Colored)"
      Enabled: true
      Topic:
        Value: /semantic/colored_points
        Depth: 1
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Size (Pixels): 5
      Style: Points
      Color Transformer: RGB8
      Decay Time: 120
      Use Fixed Frame: true

    # ── Semantic Camera Overlay (YOLOv8 annotated feed) ─────────────────────
    - Class: rviz_default_plugins/Image
      Name: "Semantic Camera"
      Enabled: true
      Topic:
        Value: /semantic/overlay
        Depth: 1
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Max Value: 1
      Min Value: 0
      Normalize Range: true

  Global Options:
    Background Color: 20; 20; 20
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/SetGoal
      Topic: /goal_pose
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 25
      Focal Point:
        X: 0
        Y: 0
        Z: 1.5
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.6
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 0.8
