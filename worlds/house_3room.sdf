<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="house_3room">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system"/>
    <plugin name="gz::sim::systems::Imu" filename="gz-sim-imu-system"/>
    <plugin name="gz::sim::systems::AirPressure" filename="gz-sim-air-pressure-system"/>
    <plugin name="gz::sim::systems::ApplyLinkWrench" filename="gz-sim-apply-link-wrench-system"/>
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>
    <gui fullscreen="false"/>

    <!-- Sunlight -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ============================================================ -->
    <!-- GROUND PLANE — 18m x 12m                                     -->
    <!-- ============================================================ -->
    <model name="ground_plane">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>18 12</size></plane></geometry>
          <surface>
            <friction><ode><mu>100</mu><mu2>50</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>18 12</size></plane></geometry>
          <material>
            <ambient>0.75 0.72 0.68 1</ambient>
            <diffuse>0.75 0.72 0.68 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================ -->
    <!-- OUTER WALLS — Invisible collisions + cyan wireframe          -->
    <!-- House: 18m wide (X: -9 to +9) × 12m deep (Y: -6 to +6)     -->
    <!-- ============================================================ -->
    <model name="outer_walls">
      <static>true</static>
      <link name="walls_link">
        <!-- Solid invisible collision walls -->
        <collision name="c_north"><pose>0 6 1.5 0 0 0</pose><geometry><box><size>18 0.15 3</size></box></geometry></collision>
        <collision name="c_south"><pose>0 -6 1.5 0 0 0</pose><geometry><box><size>18 0.15 3</size></box></geometry></collision>
        <collision name="c_east"><pose>9 0 1.5 0 0 0</pose><geometry><box><size>0.15 12 3</size></box></geometry></collision>
        <collision name="c_west"><pose>-9 0 1.5 0 0 0</pose><geometry><box><size>0.15 12 3</size></box></geometry></collision>
        <collision name="c_ceiling"><pose>0 0 3 0 0 0</pose><geometry><box><size>18 12 0.1</size></box></geometry></collision>

        <!-- Cyan wireframe: 4 vertical corner pillars -->
        <visual name="vp_nw"><pose>-8.925 5.925 1.5 0 0 0</pose><geometry><box><size>0.1 0.1 3</size></box></geometry><material><ambient>0 0.8 1 1</ambient><diffuse>0 0.8 1 1</diffuse></material></visual>
        <visual name="vp_ne"><pose>8.925 5.925 1.5 0 0 0</pose><geometry><box><size>0.1 0.1 3</size></box></geometry><material><ambient>0 0.8 1 1</ambient><diffuse>0 0.8 1 1</diffuse></material></visual>
        <visual name="vp_sw"><pose>-8.925 -5.925 1.5 0 0 0</pose><geometry><box><size>0.1 0.1 3</size></box></geometry><material><ambient>0 0.8 1 1</ambient><diffuse>0 0.8 1 1</diffuse></material></visual>
        <visual name="vp_se"><pose>8.925 -5.925 1.5 0 0 0</pose><geometry><box><size>0.1 0.1 3</size></box></geometry><material><ambient>0 0.8 1 1</ambient><diffuse>0 0.8 1 1</diffuse></material></visual>

        <!-- Cyan wireframe: top edges -->
        <visual name="vt_n"><pose>0 5.925 3 0 0 0</pose><geometry><box><size>18 0.1 0.1</size></box></geometry><material><ambient>0 0.8 1 1</ambient><diffuse>0 0.8 1 1</diffuse></material></visual>
        <visual name="vt_s"><pose>0 -5.925 3 0 0 0</pose><geometry><box><size>18 0.1 0.1</size></box></geometry><material><ambient>0 0.8 1 1</ambient><diffuse>0 0.8 1 1</diffuse></material></visual>
        <visual name="vt_e"><pose>8.925 0 3 0 0 0</pose><geometry><box><size>0.1 12 0.1</size></box></geometry><material><ambient>0 0.8 1 1</ambient><diffuse>0 0.8 1 1</diffuse></material></visual>
        <visual name="vt_w"><pose>-8.925 0 3 0 0 0</pose><geometry><box><size>0.1 12 0.1</size></box></geometry><material><ambient>0 0.8 1 1</ambient><diffuse>0 0.8 1 1</diffuse></material></visual>

        <!-- Cyan wireframe: bottom edges -->
        <visual name="vb_n"><pose>0 5.925 0.05 0 0 0</pose><geometry><box><size>18 0.1 0.1</size></box></geometry><material><ambient>0 0.8 1 1</ambient><diffuse>0 0.8 1 1</diffuse></material></visual>
        <visual name="vb_s"><pose>0 -5.925 0.05 0 0 0</pose><geometry><box><size>18 0.1 0.1</size></box></geometry><material><ambient>0 0.8 1 1</ambient><diffuse>0 0.8 1 1</diffuse></material></visual>
        <visual name="vb_e"><pose>8.925 0 0.05 0 0 0</pose><geometry><box><size>0.1 12 0.1</size></box></geometry><material><ambient>0 0.8 1 1</ambient><diffuse>0 0.8 1 1</diffuse></material></visual>
        <visual name="vb_w"><pose>-8.925 0 0.05 0 0 0</pose><geometry><box><size>0.1 12 0.1</size></box></geometry><material><ambient>0 0.8 1 1</ambient><diffuse>0 0.8 1 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ============================================================ -->
    <!-- INTERNAL WALLS — Dividing the 3 rooms with doorways          -->
    <!--                                                              -->
    <!--  Wall 1 at X = -3: Living Room | Bedroom                    -->
    <!--    Door at Y = +2 (2.5m wide: Y = 0.75 to 3.25)             -->
    <!--  Wall 2 at X = +3: Bedroom     | Study                      -->
    <!--    Door at Y = -2 (2.5m wide: Y = -3.25 to -0.75)           -->
    <!-- ============================================================ -->

    <!-- Internal Wall 1 (X = -3) — Lower segment: Y = -6 to +0.75 -->
    <model name="iwall1_lower">
      <static>true</static>
      <link name="link">
        <pose>-3 -2.625 1.5 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.15 6.75 3</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.15 6.75 3</size></box></geometry>
          <material><ambient>0.85 0.82 0.78 1</ambient><diffuse>0.85 0.82 0.78 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Internal Wall 1 (X = -3) — Upper segment: Y = +3.25 to +6 -->
    <model name="iwall1_upper">
      <static>true</static>
      <link name="link">
        <pose>-3 4.625 1.5 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.15 2.75 3</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.15 2.75 3</size></box></geometry>
          <material><ambient>0.85 0.82 0.78 1</ambient><diffuse>0.85 0.82 0.78 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Internal Wall 2 (X = +3) — Lower segment: Y = -6 to -3.25 -->
    <model name="iwall2_lower">
      <static>true</static>
      <link name="link">
        <pose>3 -4.625 1.5 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.15 2.75 3</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.15 2.75 3</size></box></geometry>
          <material><ambient>0.85 0.82 0.78 1</ambient><diffuse>0.85 0.82 0.78 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Internal Wall 2 (X = +3) — Upper segment: Y = -0.75 to +6 -->
    <model name="iwall2_upper">
      <static>true</static>
      <link name="link">
        <pose>3 2.625 1.5 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.15 6.75 3</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.15 6.75 3</size></box></geometry>
          <material><ambient>0.85 0.82 0.78 1</ambient><diffuse>0.85 0.82 0.78 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- No lintels above doorways — they would appear as obstacles
         in the 2D projected map and block navigation paths -->

    <!-- ============================================================ -->
    <!-- ROOM 1: LIVING ROOM (X: -9 to -3)                           -->
    <!-- ============================================================ -->

    <!-- Sofa — Large brown couch against north wall -->
    <model name="living_sofa">
      <static>true</static>
      <pose>-7 4.5 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.5 0.9 0.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.5 0.9 0.8</size></box></geometry>
          <material><ambient>0.55 0.35 0.18 1</ambient><diffuse>0.55 0.35 0.18 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Coffee Table — Low wooden table in front of sofa -->
    <model name="living_coffee_table">
      <static>true</static>
      <pose>-7 2.5 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.2 0.6 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.2 0.6 0.5</size></box></geometry>
          <material><ambient>0.7 0.55 0.35 1</ambient><diffuse>0.7 0.55 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- TV Stand — Against west wall -->
    <model name="living_tv_stand">
      <static>true</static>
      <pose>-8.5 -2 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.4 1.5 0.6</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.4 1.5 0.6</size></box></geometry>
          <material><ambient>0.25 0.25 0.28 1</ambient><diffuse>0.25 0.25 0.28 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Armchair — Near the doorway -->
    <model name="living_armchair">
      <static>true</static>
      <pose>-4.5 3 0.45 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.8 0.8 0.9</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.8 0.8 0.9</size></box></geometry>
          <material><ambient>0.5 0.15 0.15 1</ambient><diffuse>0.5 0.15 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ============================================================ -->
    <!-- ROOM 2: BEDROOM (X: -3 to +3) — Drone spawns here at (0,0) -->
    <!-- ============================================================ -->

    <!-- Bed — Against north wall -->
    <model name="bedroom_bed">
      <static>true</static>
      <pose>0 4.5 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.0 1.6 0.6</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.0 1.6 0.6</size></box></geometry>
          <material><ambient>0.45 0.5 0.6 1</ambient><diffuse>0.45 0.5 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Nightstand — Next to bed -->
    <model name="bedroom_nightstand">
      <static>true</static>
      <pose>-1.5 5 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.5 0.5 0.6</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.5 0.5 0.6</size></box></geometry>
          <material><ambient>0.65 0.5 0.3 1</ambient><diffuse>0.65 0.5 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Wardrobe — Tall, against south wall -->
    <model name="bedroom_wardrobe">
      <static>true</static>
      <pose>2 -4.5 1.1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.5 0.6 2.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.5 0.6 2.2</size></box></geometry>
          <material><ambient>0.35 0.22 0.12 1</ambient><diffuse>0.35 0.22 0.12 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Dresser — South side -->
    <model name="bedroom_dresser">
      <static>true</static>
      <pose>-2 -3.5 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.0 0.5 0.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.0 0.5 0.8</size></box></geometry>
          <material><ambient>0.6 0.48 0.3 1</ambient><diffuse>0.6 0.48 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ============================================================ -->
    <!-- ROOM 3: STUDY ROOM (X: +3 to +9)                            -->
    <!-- ============================================================ -->

    <!-- Desk — Work area -->
    <model name="study_desk">
      <static>true</static>
      <pose>6 3.5 0.375 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.5 0.7 0.75</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.5 0.7 0.75</size></box></geometry>
          <material><ambient>0.65 0.5 0.3 1</ambient><diffuse>0.65 0.5 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Office Chair -->
    <model name="study_chair">
      <static>true</static>
      <pose>6 2 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.6 0.6 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.6 0.6 1.0</size></box></geometry>
          <material><ambient>0.15 0.15 0.18 1</ambient><diffuse>0.15 0.15 0.18 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Bookshelf — Tall, against east wall -->
    <model name="study_bookshelf">
      <static>true</static>
      <pose>8.2 0 1.1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.2 0.4 2.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.2 0.4 2.2</size></box></geometry>
          <material><ambient>0.4 0.28 0.15 1</ambient><diffuse>0.4 0.28 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Filing Cabinet -->
    <model name="study_cabinet">
      <static>true</static>
      <pose>5 -3.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.5 0.5 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.5 0.5 1.0</size></box></geometry>
          <material><ambient>0.5 0.5 0.52 1</ambient><diffuse>0.5 0.5 0.52 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ============================================================ -->
    <!-- CEILING OBSTACLES — Fans, lights, pipes (Phase 3)            -->
    <!-- These hang from the 3.0m ceiling into the drone flight zone  -->
    <!-- ============================================================ -->

    <!-- Ceiling Fan — Bedroom (center of room, directly above spawn) -->
    <!-- Fan hub at z=2.7, blades extend down to z=2.55              -->
    <!-- Above default 1.8m altitude but visible in OctoMap 3D       -->
    <model name="ceiling_fan_bedroom">
      <static>true</static>
      <link name="link">
        <!-- Center rod hanging from ceiling -->
        <collision name="rod_col"><pose>0 0 2.85 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>0.3</length></cylinder></geometry>
        </collision>
        <visual name="rod_vis"><pose>0 0 2.85 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>0.3</length></cylinder></geometry>
          <material><ambient>0.4 0.4 0.42 1</ambient><diffuse>0.4 0.4 0.42 1</diffuse></material>
        </visual>
        <!-- Fan motor hub -->
        <collision name="hub_col"><pose>0 0 2.65 0 0 0</pose>
          <geometry><cylinder><radius>0.12</radius><length>0.1</length></cylinder></geometry>
        </collision>
        <visual name="hub_vis"><pose>0 0 2.65 0 0 0</pose>
          <geometry><cylinder><radius>0.12</radius><length>0.1</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.32 1</ambient><diffuse>0.3 0.3 0.32 1</diffuse></material>
        </visual>
        <!-- Fan blades (flat disc representing 4 blades) -->
        <collision name="blades_col"><pose>0 0 2.55 0 0 0</pose>
          <geometry><cylinder><radius>0.6</radius><length>0.04</length></cylinder></geometry>
        </collision>
        <visual name="blades_vis"><pose>0 0 2.55 0 0 0</pose>
          <geometry><cylinder><radius>0.6</radius><length>0.04</length></cylinder></geometry>
          <material><ambient>0.5 0.45 0.35 1</ambient><diffuse>0.5 0.45 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Ceiling Fan — Living Room (above coffee table area) -->
    <!-- Placed at (-6, 1) — directly in the cross-room flight path -->
    <model name="ceiling_fan_living">
      <static>true</static>
      <link name="link">
        <collision name="rod_col"><pose>-6 1 2.85 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>0.3</length></cylinder></geometry>
        </collision>
        <visual name="rod_vis"><pose>-6 1 2.85 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>0.3</length></cylinder></geometry>
          <material><ambient>0.4 0.4 0.42 1</ambient><diffuse>0.4 0.4 0.42 1</diffuse></material>
        </visual>
        <collision name="hub_col"><pose>-6 1 2.65 0 0 0</pose>
          <geometry><cylinder><radius>0.12</radius><length>0.1</length></cylinder></geometry>
        </collision>
        <visual name="hub_vis"><pose>-6 1 2.65 0 0 0</pose>
          <geometry><cylinder><radius>0.12</radius><length>0.1</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.32 1</ambient><diffuse>0.3 0.3 0.32 1</diffuse></material>
        </visual>
        <collision name="blades_col"><pose>-6 1 2.55 0 0 0</pose>
          <geometry><cylinder><radius>0.6</radius><length>0.04</length></cylinder></geometry>
        </collision>
        <visual name="blades_vis"><pose>-6 1 2.55 0 0 0</pose>
          <geometry><cylinder><radius>0.6</radius><length>0.04</length></cylinder></geometry>
          <material><ambient>0.5 0.45 0.35 1</ambient><diffuse>0.5 0.45 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Hanging Pendant Light — Near Door 1 (Bedroom-Living Room doorway) -->
    <!-- Hangs LOW at z=2.05 — forces altitude awareness near doorways    -->
    <model name="hanging_light_door1">
      <static>true</static>
      <link name="link">
        <!-- Thin wire from ceiling -->
        <collision name="wire_col"><pose>-3 2 2.55 0 0 0</pose>
          <geometry><cylinder><radius>0.01</radius><length>0.9</length></cylinder></geometry>
        </collision>
        <visual name="wire_vis"><pose>-3 2 2.55 0 0 0</pose>
          <geometry><cylinder><radius>0.01</radius><length>0.9</length></cylinder></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
        <!-- Light fixture (sphere) -->
        <collision name="light_col"><pose>-3 2 2.05 0 0 0</pose>
          <geometry><sphere><radius>0.15</radius></sphere></geometry>
        </collision>
        <visual name="light_vis"><pose>-3 2 2.05 0 0 0</pose>
          <geometry><sphere><radius>0.15</radius></sphere></geometry>
          <material><ambient>0.95 0.85 0.3 1</ambient><diffuse>0.95 0.85 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Low Horizontal Pipe — Study Room                                -->
    <!-- At z=1.9m — EXACTLY at drone flight altitude!                   -->
    <!-- This is the CRITICAL TEST CASE: drone MUST change altitude      -->
    <!-- Runs East-West across the room at (6, 0)                        -->
    <model name="low_pipe_study">
      <static>true</static>
      <link name="link">
        <!-- Horizontal pipe (rotated 90° around Y to lay flat along X) -->
        <collision name="pipe_col"><pose>6 0 1.9 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.08</radius><length>2.0</length></cylinder></geometry>
        </collision>
        <visual name="pipe_vis"><pose>6 0 1.9 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.08</radius><length>2.0</length></cylinder></geometry>
          <material><ambient>0.72 0.45 0.2 1</ambient><diffuse>0.72 0.45 0.2 1</diffuse></material>
        </visual>
        <!-- Pipe brackets (2 mounting brackets on wall/ceiling) -->
        <collision name="bracket1_col"><pose>5 0 2.45 0 0 0</pose>
          <geometry><box><size>0.06 0.06 1.1</size></box></geometry>
        </collision>
        <visual name="bracket1_vis"><pose>5 0 2.45 0 0 0</pose>
          <geometry><box><size>0.06 0.06 1.1</size></box></geometry>
          <material><ambient>0.5 0.5 0.52 1</ambient><diffuse>0.5 0.5 0.52 1</diffuse></material>
        </visual>
        <collision name="bracket2_col"><pose>7 0 2.45 0 0 0</pose>
          <geometry><box><size>0.06 0.06 1.1</size></box></geometry>
        </collision>
        <visual name="bracket2_vis"><pose>7 0 2.45 0 0 0</pose>
          <geometry><box><size>0.06 0.06 1.1</size></box></geometry>
          <material><ambient>0.5 0.5 0.52 1</ambient><diffuse>0.5 0.5 0.52 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ============================================================ -->
    <!-- MARKERS — Start (green) and Destination (blue)               -->
    <!-- ============================================================ -->

    <!-- Start: Green disc in Living Room -->
    <model name="marker_start">
      <static>true</static>
      <pose>-7 -3 0.01 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.4</radius><length>0.02</length></cylinder></geometry>
          <material><ambient>0.1 0.9 0.2 1</ambient><diffuse>0.1 0.9 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Destination: Blue disc in Study Room -->
    <model name="marker_destination">
      <static>true</static>
      <pose>7 3 0.01 0 0 0</pose>
      <link name="link">
