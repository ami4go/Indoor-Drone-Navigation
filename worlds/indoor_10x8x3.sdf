<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="indoor_10x8x3">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system"/>
    <plugin name="gz::sim::systems::Imu" filename="gz-sim-imu-system"/>
    <plugin name="gz::sim::systems::AirPressure" filename="gz-sim-air-pressure-system"/>
    <plugin name="gz::sim::systems::ApplyLinkWrench" filename="gz-sim-apply-link-wrench-system"/>
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>
    <gui fullscreen="false"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>10 8</size></plane></geometry>
          <surface>
            <friction><ode><mu>100</mu><mu2>50</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>10 8</size></plane></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Invisible Physics Walls with Visual Wireframe -->
    <model name="walls">
      <static>true</static>
      
      <!-- INVISIBLE COLLISIONS (Solid Walls) -->
      <link name="physics_walls">
        <collision name="c_front"><pose>0 4 1.5 0 0 0</pose><geometry><box><size>10 0.1 3</size></box></geometry></collision>
        <collision name="c_back"><pose>0 -4 1.5 0 0 0</pose><geometry><box><size>10 0.1 3</size></box></geometry></collision>
        <collision name="c_left"><pose>5 0 1.5 0 0 0</pose><geometry><box><size>0.1 8 3</size></box></geometry></collision>
        <collision name="c_right"><pose>-5 0 1.5 0 0 0</pose><geometry><box><size>0.1 8 3</size></box></geometry></collision>
        <collision name="c_ceiling"><pose>0 0 3 0 0 0</pose><geometry><box><size>10 8 0.1</size></box></geometry></collision>

        <!-- VISUAL WIREFRAME (Neon Blue Outlines) -->
        <!-- 4 Vertical Pillars -->
        <visual name="v_p1"><pose>4.95 3.95 1.5 0 0 0</pose><geometry><box><size>0.1 0.1 3</size></box></geometry><material><ambient>0 0.8 1 1</ambient><diffuse>0 0.8 1 1</diffuse></material></visual>
        <visual name="v_p2"><pose>-4.95 3.95 1.5 0 0 0</pose><geometry><box><size>0.1 0.1 3</size></box></geometry><material><ambient>0 0.8 1 1</ambient><diffuse>0 0.8 1 1</diffuse></material></visual>
        <visual name="v_p3"><pose>4.95 -3.95 1.5 0 0 0</pose><geometry><box><size>0.1 0.1 3</size></box></geometry><material><ambient>0 0.8 1 1</ambient><diffuse>0 0.8 1 1</diffuse></material></visual>
        <visual name="v_p4"><pose>-4.95 -3.95 1.5 0 0 0</pose><geometry><box><size>0.1 0.1 3</size></box></geometry><material><ambient>0 0.8 1 1</ambient><diffuse>0 0.8 1 1</diffuse></material></visual>
        
        <!-- Top Edges -->
        <visual name="v_t1"><pose>0 3.95 3 0 0 0</pose><geometry><box><size>10 0.1 0.1</size></box></geometry><material><ambient>0 0.8 1 1</ambient><diffuse>0 0.8 1 1</diffuse></material></visual>
        <visual name="v_t2"><pose>0 -3.95 3 0 0 0</pose><geometry><box><size>10 0.1 0.1</size></box></geometry><material><ambient>0 0.8 1 1</ambient><diffuse>0 0.8 1 1</diffuse></material></visual>
        <visual name="v_t3"><pose>4.95 0 3 0 0 0</pose><geometry><box><size>0.1 8 0.1</size></box></geometry><material><ambient>0 0.8 1 1</ambient><diffuse>0 0.8 1 1</diffuse></material></visual>
        <visual name="v_t4"><pose>-4.95 0 3 0 0 0</pose><geometry><box><size>0.1 8 0.1</size></box></geometry><material><ambient>0 0.8 1 1</ambient><diffuse>0 0.8 1 1</diffuse></material></visual>

        <!-- Bottom Edges -->
        <visual name="v_b1"><pose>0 3.95 0.05 0 0 0</pose><geometry><box><size>10 0.1 0.1</size></box></geometry><material><ambient>0 0.8 1 1</ambient><diffuse>0 0.8 1 1</diffuse></material></visual>
        <visual name="v_b2"><pose>0 -3.95 0.05 0 0 0</pose><geometry><box><size>10 0.1 0.1</size></box></geometry><material><ambient>0 0.8 1 1</ambient><diffuse>0 0.8 1 1</diffuse></material></visual>
        <visual name="v_b3"><pose>4.95 0 0.05 0 0 0</pose><geometry><box><size>0.1 8 0.1</size></box></geometry><material><ambient>0 0.8 1 1</ambient><diffuse>0 0.8 1 1</diffuse></material></visual>
        <visual name="v_b4"><pose>-4.95 0 0.05 0 0 0</pose><geometry><box><size>0.1 8 0.1</size></box></geometry><material><ambient>0 0.8 1 1</ambient><diffuse>0 0.8 1 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ============================================== -->
    <!-- OBSTACLES — 3 objects the drone must avoid     -->
    <!-- ============================================== -->

    <!-- Obstacle 1: Tall Red Pillar at (0, 1) -->
    <!-- This sits near the center of the room, blocking the direct path -->
    <model name="obstacle_pillar_red">
      <static>true</static>
      <pose>0 1 1.25 0 0 0</pose>   <!-- Z=1.25 because the box is 2.5m tall, so center is at half-height -->
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.5 0.5 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.5 2.5</size></box></geometry>
          <material>
            <ambient>0.9 0.15 0.15 1</ambient>   <!-- Red color -->
            <diffuse>0.9 0.15 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Obstacle 2: Low Orange Wall at (-1.5, -1) -->
    <!-- A wide-ish, short wall — drone can fly over it or go around -->
    <model name="obstacle_wall_orange">
      <static>true</static>
      <pose>-1.5 -1 0.75 0 0 0</pose>   <!-- Z=0.75 because the wall is 1.5m tall -->
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.0 0.3 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.0 0.3 1.5</size></box></geometry>
          <material>
            <ambient>0.95 0.55 0.1 1</ambient>   <!-- Orange color -->
            <diffuse>0.95 0.55 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Obstacle 3: Tall Yellow Pillar at (2, 0) -->
    <!-- On the right side, forces the drone to weave between obstacles -->
    <model name="obstacle_pillar_yellow">
      <static>true</static>
      <pose>2 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.6 0.6 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.6 0.6 2.5</size></box></geometry>
          <material>
            <ambient>0.95 0.85 0.1 1</ambient>   <!-- Yellow color -->
            <diffuse>0.95 0.85 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================== -->
    <!-- MARKERS — Start (green) and Destination (blue) -->
    <!-- ============================================== -->

    <!-- Start Marker: Green disc on the floor at (-3, -2) -->
    <model name="marker_start">
      <static>true</static>
      <pose>-3 -2 0.01 0 0 0</pose>   <!-- Z=0.01 so it sits just above the floor -->
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.4</radius><length>0.02</length></cylinder></geometry>
          <material>
            <ambient>0.1 0.9 0.2 1</ambient>   <!-- Green color -->
            <diffuse>0.1 0.9 0.2 1</diffuse>
          </material>
        </visual>
        <!-- No collision needed — it's just a visual marker, drone can land on it -->
      </link>
    </model>

    <!-- Destination Marker: Blue disc on the floor at (3, 2) -->
    <model name="marker_destination">
      <static>true</static>
      <pose>3 2 0.01 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.4</radius><length>0.02</length></cylinder></geometry>
          <material>
            <ambient>0.1 0.4 0.95 1</ambient>   <!-- Blue color -->
            <diffuse>0.1 0.4 0.95 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
